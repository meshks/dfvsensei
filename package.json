    "@hookform/resolvers": "5.7.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/supabase-js": "2.111.0",
    "@anthropic-ai/sdk": "0.115.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.4.0",
    "class-variance-authority": "0.7.1",
    "lucide-react": "0.545.0",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.14.0",
