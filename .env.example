# Copy to .env.local for local development. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Direct Postgres connection, used by scripts/db/migrate.ts and scripts/db/seed.ts
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# "mock" runs every AI operation against fixture data with no external calls.
# Switch to "anthropic" and set ANTHROPIC_API_KEY once you have one (server-side only,
# never exposed to the client bundle -- see ARCHITECTURE.md).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
